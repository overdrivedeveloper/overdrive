# Vol engine environment. Copy to a private env file; never commit real values. Keys are keystores, never raw.
NODE_ENV=production
DATABASE_URL=postgres://vol_engine@localhost/overdrive
VOL_SIGNER_KEYSTORE=/etc/overdrive/vol-signer.json
VOL_SIGNER_KEYSTORE_PASSWORD_FILE=/etc/overdrive/vol-signer.password
VOL_SENDER_KEYSTORE=/etc/overdrive/vol-sender.json
VOL_SENDER_KEYSTORE_PASSWORD_FILE=/etc/overdrive/vol-sender.password
VOL_ORACLE_ADDRESS=
VOL_CHAIN_ID=4663
VOL_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Sending is off unless this is exactly 1.
VOL_SEND=0
VOL_CLOCK=wall
