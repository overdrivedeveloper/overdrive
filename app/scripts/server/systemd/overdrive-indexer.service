[Unit]
Description=Overdrive indexer
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=overdrive.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=overdrive-indexer
Group=overdrive-indexer
Slice=overdrive.slice
WorkingDirectory=/opt/overdrive/current/app
EnvironmentFile=/etc/overdrive/overdrive.env
EnvironmentFile=/etc/overdrive/db.env
EnvironmentFile=/etc/overdrive/indexer.env
Environment=NODE_ENV=production
ExecStart=/opt/overdrive/bin/bun src/bin/indexer.ts
Restart=on-failure
RestartSec=5
MemoryMax=256M
MemorySwapMax=0
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/overdrive/indexer

[Install]
WantedBy=overdrive.target
