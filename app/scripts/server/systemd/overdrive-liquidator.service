[Unit]
Description=Overdrive liquidator
After=network-online.target postgresql.service docker.service
Wants=network-online.target
PartOf=overdrive.target
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/etc/overdrive/keys/liquidator.json

[Service]
Type=simple
User=overdrive-liquidator
Group=overdrive-liquidator
Slice=overdrive.slice
WorkingDirectory=/opt/overdrive/current/app
EnvironmentFile=/etc/overdrive/overdrive.env
EnvironmentFile=/etc/overdrive/db.env
EnvironmentFile=/etc/overdrive/liquidator.env
Environment=NODE_ENV=production
ExecStart=/opt/overdrive/bin/bun src/bin/liquidator.ts
Restart=on-failure
RestartSec=5
MemoryMax=192M
MemorySwapMax=0
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/overdrive/liquidator

[Install]
WantedBy=overdrive.target
