[Unit]
Description=Overdrive hedger
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=overdrive.target
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/etc/overdrive/keys/hedger.json

[Service]
Type=simple
User=overdrive-hedger
Group=overdrive-hedger
Slice=overdrive.slice
WorkingDirectory=/opt/overdrive/current/app
EnvironmentFile=/etc/overdrive/overdrive.env
EnvironmentFile=/etc/overdrive/db.env
EnvironmentFile=/etc/overdrive/hedger.env
Environment=NODE_ENV=production
ExecStart=/opt/overdrive/bin/bun src/bin/hedger.ts
Restart=on-failure
RestartSec=5
MemoryMax=256M
MemorySwapMax=0
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/overdrive/hedger

[Install]
WantedBy=overdrive.target
