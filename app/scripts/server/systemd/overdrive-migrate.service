[Unit]
Description=Overdrive database migrations (run by deploy.sh before the services restart)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=overdrive
Group=overdrive
Slice=overdrive.slice
WorkingDirectory=/opt/overdrive/current/app
EnvironmentFile=/etc/overdrive/overdrive.env
EnvironmentFile=/etc/overdrive/db.env
Environment=NODE_ENV=production
ExecStart=/opt/overdrive/bin/bun src/bin/migrate.ts
MemoryMax=384M
MemorySwapMax=0
Nice=10
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/overdrive/data
