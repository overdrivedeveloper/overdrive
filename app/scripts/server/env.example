# Overdrive shared environment: copied to /etc/overdrive/overdrive.env (root, 0600) by provision.sh on the first run.
# Read by systemd as root before each service drops to its own user. Never put a key or a password here: keys are
# keystores in /etc/overdrive/keys, and DATABASE_URL lives in /etc/overdrive/db.env (written by provision.sh).
# Every name below is accepted by app/src/config.ts or by the service that reads it (deploy-local.test.sh loads this
# file through loadConfig and checks every job name against the code's exported lists).
# Replace every CHANGE_ME before deploying; deploy.sh refuses while one is left.

NODE_ENV=production
# mainnet (chain 4663) or testnet (46630: the network profile deploy.sh follows)
NETWORK=CHANGE_ME
CHAIN_ID=CHANGE_ME
# /opt/overdrive/current/app/deployments/<chain id>.json (shipped with every release by deploy.sh)
DEPLOYMENT_FILE=CHANGE_ME
LOG_LEVEL=info

# ---- chain access (free endpoints only; an Alchemy key is optional, blank = public endpoint only)
PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ALCHEMY_API_KEYS=
INDEXER_CONFIRMATIONS=2

# ---- ports: this box is shared, so Overdrive owns 38101-38109 (provision.sh refuses if one is taken by anything else)
API_PORT=38101
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=38102

# ---- API (read only; Caddy is the only proxy in front of it)
CORS_ORIGINS=
API_CLIENT_IP_HEADER=x-forwarded-for
API_RATE_LIMIT_PER_MINUTE=300
API_WRITE_RATE_LIMIT_PER_MINUTE=30
API_QUOTER=chain

# ---- MCP (hosted flavour: read only, holds no key)
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_CLIENT_IP_HEADER=x-forwarded-for
MCP_TRUSTED_PROXIES=loopback
MCP_ALLOWED_ORIGINS=

# ---- crank (keystore: /etc/overdrive/keys/crank.json, set in crank.env by provision.sh)
CRANK_DRY_RUN=1
CRANK_AUTOPAUSE=0
CRANK_ENABLED_JOBS=sessions,toll,poke,vol-watch,queued-sells,fees,risk-monitor,admin-watch,gas-watch,heartbeat
CRANK_DISABLED_JOBS=
CRANK_TOLL_MAX_AGE_SECONDS=3600
CRANK_TOLL_BATCH=40
VOL_STALE_WARN_SECONDS=900
FEES_MIN_USDG=50
GAS_WATCH_REALERT_HOURS=6

# ---- hedger (dry run until the owner arms it; mainnet live needs HEDGER_LIVE_CONFIRM=real-funds as well)
HEDGER_DRY_RUN=1
HEDGER_LIVE_CONFIRM=
HEDGER_ENABLED_JOBS=cycle,post,reconcile
HEDGER_DISABLED_JOBS=
HEDGER_VENUES=hyperliquid
HL_NETWORK=mainnet
HL_ACCOUNT_ADDRESS=

# ---- liquidator (dry run until the owner arms it; mainnet live needs LIQUIDATOR_LIVE_CONFIRM=real-funds as well)
LIQUIDATOR_DRY_RUN=1
LIQUIDATOR_LIVE_CONFIRM=
LIQUIDATOR_ENABLED_JOBS=scan,seal,execute,watch
LIQUIDATOR_DISABLED_JOBS=

# ---- vol engine (python; reads only VOL_* names and DATABASE_URL; sending is off unless VOL_SEND is exactly 1)
VOL_ORACLE_ADDRESS=CHANGE_ME
VOL_CHAIN_ID=4663
VOL_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VOL_SEND=0
VOL_CLOCK=wall

# ---- risk-sim (nightly timer; the risk numbers come from the spec, change them only through the Governor process)
RISK_MAX_LOSS_BPS=1500
