# Overdrive site file. provision.sh renders it (the __NAME__ words) and installs it as ONE separate file:
#   /etc/caddy/conf.d/overdrive.caddy
# It never edits another project's site, and Caddy is reloaded only after `caddy validate` accepts the whole config.
# Overdrive owns 127.0.0.1:38101 (api) and 127.0.0.1:38102 (mcp).

__API_DOMAIN__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy 127.0.0.1:38101 {
		header_up X-Forwarded-For {remote_host}
		health_uri /v1/health
		health_interval 30s
	}
}

# BEGIN mcp
__MCP_DOMAIN__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy 127.0.0.1:38102 {
		header_up X-Forwarded-For {remote_host}
		flush_interval -1
	}
}
# END mcp
