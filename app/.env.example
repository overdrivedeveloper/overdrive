# Overdrive app services (api, indexer, crank, hedger, liquidator): every variable app/src/config.ts reads.
# Copy to .env for local work. app/test/env-example.test.ts keeps this file equal to config.ts and loads it through
# loadConfig, so it cannot drift. Never put a private key or a password here: keys are keystores, never env values.
# The production file is app/scripts/server/env.example (copied to /etc/overdrive by provision.sh).

NODE_ENV=development
# fork (31337, local anvil), testnet (46630) or mainnet (4663). CHAIN_ID must match NETWORK.
NETWORK=fork
CHAIN_ID=31337
# Postgres for the indexer and services. The API itself reads through API_DB_READONLY_URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/overdrive
DEPLOYMENT_FILE=deployments/anvil.json
LOG_LEVEL=info
# Optional: a 0x address the service refuses to run without matching (blank = no check).
EXPECT_ADDRESS=

# ---- chain access (free endpoints only; Alchemy keys are optional and comma separated)
PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Fork or testnet only; refused on mainnet.
RPC_URL_OVERRIDE=
# Blank = the default free backup on mainnet, none elsewhere.
RPC_BACKUP_URL=
ALCHEMY_API_KEYS=
ALCHEMY_URL_TEMPLATE=https://robinhood-mainnet.g.alchemy.com/v2/{key}
RPC_ROUTE_LOGS=public,alchemy
RPC_ROUTE_STATE=public,alchemy
RPC_ROUTE_TX=alchemy,public

# ---- indexer
INDEXER_POLL_ACTIVE_MS=5000
INDEXER_POLL_BASE_MS=15000
INDEXER_POLL_IDLE_MS=60000
INDEXER_CATCHUP_CONCURRENCY=3
# Blocks behind the head before ingesting: 0 on the fork, 2 on mainnet and testnet.
INDEXER_CONFIRMATIONS=0
INDEXER_SNAPSHOT_HEARTBEAT_MS=600000

# ---- job switches (enabled minus disabled)
CRANK_ENABLED_JOBS=sessions,toll,poke,vol-watch,queued-sells,fees,risk-monitor,admin-watch,gas-watch,pyth-push,heartbeat
CRANK_DISABLED_JOBS=
HEDGER_ENABLED_JOBS=cycle,post,reconcile
HEDGER_DISABLED_JOBS=
LIQUIDATOR_ENABLED_JOBS=scan,seal,execute,watch
LIQUIDATOR_DISABLED_JOBS=

# ---- crank
CRANK_DRY_RUN=0
CRANK_AUTOPAUSE=0
CRANK_GAS_MULTIPLIER_BPS=15000
CRANK_GAS_HEADROOM=500000
CRANK_GAS_CAP=32000000
CRANK_TOLL_MAX_AGE_SECONDS=3600
CRANK_TOLL_BATCH=40
CRANK_TOLL_BATCH_MAX=45
CRANK_TOLL_GAS_TARGET=8000000
CRANK_QUEUE_MAX_PER_PASS=25
CRANK_QUEUE_RETRY_MS=600000
VOL_STALE_WARN_SECONDS=900
FEES_MIN_USDG=50

# ---- Pyth push (I5-2): the crank pushes signed Hermes prices; with no key the job stays idle and warns
# Operator: put the Hermes API key here (this file is the service env, never committed). Blank = idle.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_API_KEY=
PYTH_HERMES_AUTH_HEADER=x-api-key
PYTH_PUSH_INTERVAL_SECONDS=45
PYTH_PUSH_FRESH_PERCENT=50
PYTH_PUSH_MAX_RETRIES=3
PYTH_PUSH_BACKOFF_MS=1000
PYTH_PUSH_DAILY_BUDGET_ETH=0.02

# ---- gas alerts (ETH balances below these raise an alert)
GAS_WATCH_MIN_ETH_CRANK=0.01
GAS_WATCH_MIN_ETH_HEDGER=0.01
GAS_WATCH_MIN_ETH_LIQUIDATOR=0.01
GAS_WATCH_MIN_ETH_VOL_SIGNER=0.001
GAS_WATCH_MIN_ETH_VOL_SENDER=0.01
GAS_WATCH_REALERT_HOURS=6

# ---- alerts
TELEGRAM_ENV_FILE=
TELEGRAM_API_BASE=https://api.telegram.org

# ---- API (read only; holds no key)
API_PORT=3101
CORS_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=300
API_WRITE_RATE_LIMIT_PER_MINUTE=30
API_CLIENT_IP_HEADER=cf-connecting-ip
API_QUOTE_CACHE_MS=2000
API_QUOTE_MAX_RPC_PER_REQUEST=3
API_DB_READONLY_URL=
QUOTER_ADDRESS=
# chain, or mock (fork network only)
API_QUOTER=chain
