# Production environment template for the crank (bun run src/bin/crank.ts). Keystore form only: no raw key variables.
# Copy to /etc/overdrive/crank.env (root:overdrive 0440) and fill in. Never put a wallet key or a keystore password in this file (the Hermes API key is a service credential and belongs here).
NODE_ENV=production
NETWORK=mainnet
CHAIN_ID=4663
DATABASE_URL=postgres://overdrive@127.0.0.1:5432/overdrive
DEPLOYMENT_FILE=deployments/mainnet.json
CRANK_KEYSTORE=/etc/overdrive/crank.keystore.json
CRANK_KEYSTORE_PASSWORD_FILE=/etc/overdrive/crank.password
# Dry run stays 1 until the owner arms the crank: every job simulates (eth_call + gas estimate) and sends nothing.
CRANK_DRY_RUN=1
# 0 = the risk monitor only alerts. The crank key holds no guardian role unless the deployment grants it.
CRANK_AUTOPAUSE=0
CRANK_ENABLED_JOBS=sessions,toll,poke,vol-watch,queued-sells,fees,risk-monitor,admin-watch,gas-watch,pyth-push,heartbeat
CRANK_DISABLED_JOBS=
CRANK_TOLL_MAX_AGE_SECONDS=3600
CRANK_TOLL_BATCH=40
VOL_STALE_WARN_SECONDS=900
FEES_MIN_USDG=50

# ---- Pyth push (I5-2): the crank pushes signed Hermes prices; with no key the job stays idle and warns
# Operator: put the Hermes API key here (this file is the service env, never committed). Blank = idle.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_API_KEY=
PYTH_HERMES_AUTH_HEADER=x-api-key
PYTH_PUSH_INTERVAL_SECONDS=45
PYTH_PUSH_FRESH_PERCENT=50
PYTH_PUSH_MAX_RETRIES=3
PYTH_PUSH_BACKOFF_MS=1000
PYTH_PUSH_DAILY_BUDGET_ETH=0.02
GAS_WATCH_REALERT_HOURS=6
