{
  "name": "@overdrive/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run src/bin/migrate.ts",
    "indexer": "bun run src/bin/indexer.ts",
    "gen-abi": "bun run scripts/gen-abi-ts.ts",
    "gen-abi:check": "bun run scripts/gen-abi-ts.ts --check",
    "db:generate": "drizzle-kit generate",
    "api": "bun run src/bin/api.ts",
    "dump-openapi": "bun run scripts/dump-openapi.ts",
    "lint-copy": "bun run scripts/lint-copy.ts",
    "gen-formula": "bun run scripts/gen-formula.ts",
    "crank": "bun run src/bin/crank.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "ajv": "8.17.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "viem": "2.57.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
