# Public build config. Every VITE_ value ships to the browser, so nothing private goes here.
VITE_CHAIN_ID=4663
# Base URL of the Overdrive API. Empty calls it on the site's own origin.
VITE_API_ORIGIN=
# Reown (WalletConnect) project id for mobile wallets. The value is set in the Vercel project env
# (production and preview), not here. Empty hides the WalletConnect option.
VITE_REOWN_PROJECT_ID=
