#!/usr/bin/env bash
# pre-push hook: refuse to push a commit whose exact tree has no all-green ci-local stamp.
# GitHub Actions is skipped on the private repo, so scripts/ci-local.sh is the CI; it writes
# .ci-local/green/<sha>.json (commit, tree, jobs, time, tool versions) on an all-green run on a clean tree.
# A stamp counts when its tree hash equals the pushed commit's tree (so a fast-forward or a rebase onto the same
# content is fine) and its "jobs" list (the jobs that run really ran: an --only run records only its subset) holds
# every required job. The required set is every ci-local job, contracts (forge test) and slither included. Only the
# "jobs" line is read, so a tool name elsewhere in the stamp ("python", "forge") never stands in for a job.
# Stamps are searched in this checkout and every worktree.
# Public copies: sync-public.py pushes to the public remote a commit whose tree is the private tree minus the state's
# "excludePaths" (the private denylist), so its tree never has a stamp of its own. It sets OD_SYNC_STATE (the state file)
# for the push. A push to that state's "publicRemote" is accepted ONLY when the private source of the pushed commit
# (the sync journal <state>.pending.json, else the map <state>.map.jsonl) has a full stamp for its tree AND the pushed
# tree equals that stamped tree after removing exactly the excludePaths (temporary index: read-tree, rm --cached,
# write-tree). One changed byte, a missing source, or a source without a stamp is refused as before.
# Emergency override: OD_SKIP_CI_GATE="<reason>" git push ...   (the reason is mandatory and appended to
# .ci-local/overrides.log). OD_REQUIRED_JOBS replaces the required set; a set that drops any default job is an
# override too and is logged to the same file.
# bash 3.2 safe.
set -uo pipefail
default_jobs="hygiene semgrep contracts app guard scripts python web sdk slither"
required="${OD_REQUIRED_JOBS:-$default_jobs}"
top="$(git rev-parse --show-toplevel)"
dropped=""
for j in $default_jobs; do case " $required " in *" $j "*) ;; *) dropped="$dropped $j" ;; esac; done
if [ -n "$dropped" ]; then
  mkdir -p "$top/.ci-local"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) required jobs narrowed by OD_REQUIRED_JOBS, dropped:$dropped" >> "$top/.ci-local/overrides.log"
  echo "pre-push: OD_REQUIRED_JOBS drops$dropped (logged to .ci-local/overrides.log)" >&2
fi
zero="0000000000000000000000000000000000000000"

dirs="$top/.ci-local/green"
for wt in $(git worktree list --porcelain | sed -n 's/^worktree //p' | tr ' ' '#'); do
  dirs="$dirs $(echo "$wt" | tr '#' ' ' | sed 's/ /\\ /g')/.ci-local/green"
done

stamped() { # $1 = tree hash
  local d f ok j jobs
  for d in $dirs; do
    d="$(echo "$d" | sed 's/\\ / /g')"
    [ -d "$d" ] || continue
    for f in "$d"/*.json; do
      [ -f "$f" ] || continue
      grep -q "\"tree\": \"$1\"" "$f" || continue
      jobs="$(grep '"jobs":' "$f" | head -1)"
      ok=1
      for j in $required; do case "$jobs" in *"\"$j\""*) ;; *) ok=0 ;; esac; done
      [ "$ok" -eq 1 ] && return 0
    done
  done
  return 1
}

# public_ok <pushed sha> <pushed tree> <remote>: 0 when the pushed public commit is the exact stamped private tree
# minus excludePaths (see the header). Prints its reason on refusal.
public_ok() {
  local st="${OD_SYNC_STATE:-}" info premote priv ptree tmpd etree
  [ -n "$st" ] && [ -f "$st" ] || return 1
  info="$(python3 -I - "$st" "$1" <<'PY'
import json, os, sys
st_path, pushed = sys.argv[1], sys.argv[2]
st = json.load(open(st_path))
print("remote\t" + str(st.get("publicRemote", "")))
priv = ""
pend = st_path + ".pending.json"
if os.path.exists(pend):
    j = json.load(open(pend))
    if j.get("publicSha") == pushed:
        priv = j.get("privateSha", "")
if not priv and os.path.exists(st_path + ".map.jsonl"):
    for line in open(st_path + ".map.jsonl"):
        line = line.strip()
        if line and json.loads(line).get("public") == pushed:
            priv = json.loads(line).get("private", "")
print("priv\t" + priv)
for p in st.get("excludePaths") or []:
    print("x\t" + p)
PY
)" || { echo "pre-push: cannot read sync state $st" >&2; return 1; }
  premote="$(printf '%s\n' "$info" | sed -n 's/^remote	//p')"
  [ -n "$premote" ] && [ "$3" = "$premote" ] || return 1
  priv="$(printf '%s\n' "$info" | sed -n 's/^priv	//p')"
  if [ -z "$priv" ] || ! git cat-file -e "$priv^{commit}" 2>/dev/null; then
    echo "pre-push: public push $1: no private source commit in the sync journal or map" >&2; return 1
  fi
  ptree="$(git rev-parse "$priv^{tree}")"
  if ! stamped "$ptree"; then
    echo "pre-push: public push $1: private source $priv has no all-green ci-local stamp for tree $ptree" >&2; return 1
  fi
  tmpd="$(mktemp -d)"
  GIT_INDEX_FILE="$tmpd/index" git read-tree "$ptree" || { rm -rf "$tmpd"; return 1; }
  printf '%s\n' "$info" | sed -n 's/^x	//p' | while IFS= read -r p; do
    [ -n "$p" ] && GIT_INDEX_FILE="$tmpd/index" git rm --cached -r -f -q --ignore-unmatch -- "$p" >/dev/null
  done
  etree="$(GIT_INDEX_FILE="$tmpd/index" git write-tree)"
  rm -rf "$tmpd"
  if [ "$etree" != "$2" ]; then
    echo "pre-push: public push $1: tree $2 is not the stamped private tree $ptree minus excludePaths ($etree)" >&2; return 1
  fi
  echo "pre-push: public push $1 accepted: tree = stamped private $priv minus excludePaths" >&2
  return 0
}

remote="${1:-}"
bad=0
while read -r lref lsha rref rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "$lsha" = "$zero" ] && continue   # deleting a ref pushes no code
  tree="$(git rev-parse "$lsha^{tree}" 2>/dev/null)" || continue
  if ! stamped "$tree" && ! public_ok "$lsha" "$tree" "$remote"; then
    echo "pre-push: refusing $lref ($lsha): no all-green ci-local stamp for tree $tree" >&2
    bad=1
  fi
done

if [ "$bad" -eq 1 ]; then
  if [ -n "${OD_SKIP_CI_GATE:-}" ]; then
    mkdir -p "$top/.ci-local"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) override: $OD_SKIP_CI_GATE" >> "$top/.ci-local/overrides.log"
    echo "pre-push: OD_SKIP_CI_GATE set, push allowed and logged to .ci-local/overrides.log" >&2
    exit 0
  fi
  echo "pre-push: commit the work, then run every job: bash scripts/ci-local.sh" >&2
  echo "pre-push: required jobs: $required (a stamp from an --only subset does not count)" >&2
  echo "pre-push: emergency only: OD_SKIP_CI_GATE=\"<reason>\" git push (the reason is logged)" >&2
  exit 1
fi
exit 0
