#!/usr/bin/env bash
# pre-push hook: refuse to push a commit whose exact tree has no all-green ci-local stamp.
# GitHub Actions is skipped on the private repo, so scripts/ci-local.sh is the CI; it writes
# .ci-local/green/<sha>.json (commit, tree, jobs, time, tool versions) on an all-green run on a clean tree.
# A stamp counts when its tree hash equals the pushed commit's tree (so a fast-forward or a rebase onto the same
# content is fine) and its "jobs" list (the jobs that run really ran: an --only run records only its subset) holds
# every required job. The required set is every ci-local job, contracts (forge test) and slither included. Only the
# "jobs" line is read, so a tool name elsewhere in the stamp ("python", "forge") never stands in for a job.
# Stamps are searched in this checkout and every worktree.
# Emergency override: OD_SKIP_CI_GATE="<reason>" git push ...   (the reason is mandatory and appended to
# .ci-local/overrides.log). OD_REQUIRED_JOBS replaces the required set; a set that drops any default job is an
# override too and is logged to the same file.
# bash 3.2 safe.
set -uo pipefail
default_jobs="hygiene semgrep contracts app guard scripts python web sdk slither"
required="${OD_REQUIRED_JOBS:-$default_jobs}"
top="$(git rev-parse --show-toplevel)"
dropped=""
for j in $default_jobs; do case " $required " in *" $j "*) ;; *) dropped="$dropped $j" ;; esac; done
if [ -n "$dropped" ]; then
  mkdir -p "$top/.ci-local"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) required jobs narrowed by OD_REQUIRED_JOBS, dropped:$dropped" >> "$top/.ci-local/overrides.log"
  echo "pre-push: OD_REQUIRED_JOBS drops$dropped (logged to .ci-local/overrides.log)" >&2
fi
zero="0000000000000000000000000000000000000000"

dirs="$top/.ci-local/green"
for wt in $(git worktree list --porcelain | sed -n 's/^worktree //p' | tr ' ' '#'); do
  dirs="$dirs $(echo "$wt" | tr '#' ' ' | sed 's/ /\\ /g')/.ci-local/green"
done

stamped() { # $1 = tree hash
  local d f ok j jobs
  for d in $dirs; do
    d="$(echo "$d" | sed 's/\\ / /g')"
    [ -d "$d" ] || continue
    for f in "$d"/*.json; do
      [ -f "$f" ] || continue
      grep -q "\"tree\": \"$1\"" "$f" || continue
      jobs="$(grep '"jobs":' "$f" | head -1)"
      ok=1
      for j in $required; do case "$jobs" in *"\"$j\""*) ;; *) ok=0 ;; esac; done
      [ "$ok" -eq 1 ] && return 0
    done
  done
  return 1
}

bad=0
while read -r lref lsha rref rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "$lsha" = "$zero" ] && continue   # deleting a ref pushes no code
  tree="$(git rev-parse "$lsha^{tree}" 2>/dev/null)" || continue
  if ! stamped "$tree"; then
    echo "pre-push: refusing $lref ($lsha): no all-green ci-local stamp for tree $tree" >&2
    bad=1
  fi
done

if [ "$bad" -eq 1 ]; then
  if [ -n "${OD_SKIP_CI_GATE:-}" ]; then
    mkdir -p "$top/.ci-local"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) override: $OD_SKIP_CI_GATE" >> "$top/.ci-local/overrides.log"
    echo "pre-push: OD_SKIP_CI_GATE set, push allowed and logged to .ci-local/overrides.log" >&2
    exit 0
  fi
  echo "pre-push: commit the work, then run every job: bash scripts/ci-local.sh" >&2
  echo "pre-push: required jobs: $required (a stamp from an --only subset does not count)" >&2
  echo "pre-push: emergency only: OD_SKIP_CI_GATE=\"<reason>\" git push (the reason is logged)" >&2
  exit 1
fi
exit 0
